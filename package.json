{
  "name": "abuddy",
  "description": "Vibe working platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "author": {
    "email": "angel.santiago@tutanota.com",
    "name": "Angel Santiago",
    "url": "https://clientlabs.com"
  },
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "postinstall": "cd packages/api && npm rebuild node-pty",
    "build": "npm run build -ws --if-present",
    "build-prod": "sh build/build.sh",
    "prod-app": "sh build/prod/run.sh",
    "clean-prod": "sh build/prod/clean.sh",
    "verify-signing": "sh build/prod/verify-signing.sh",
    "release": "sh build/release/release.sh",
    "release:minor": "sh build/release/release.sh minor",
    "release:major": "sh build/release/release.sh major",
    "build-prod:signed": "sh -c 'set -a; . ./.env.signing; set +a; sh build/build.sh'",
    "rebuild": "cd packages/api && npm rebuild",
    "package:all": "electron-builder --mac --win --linux",
    "test": "npx playwright test ./tests/e2e.spec.ts",
    "start": "SKIP_DSL_GEN=1 npm run build:be && node packages/dev-mode.js",
    "start:gen": "npm run build:be && node packages/dev-mode.js",
    "start:inspect": "npm run build:be && ELECTRON_INSPECT=true node packages/dev-mode.js",
    "start:no-build": "node packages/dev-mode.js",
    "build:be": "npm run build --workspace @app/api",
    "typecheck": "npm run typecheck:fe && npm run typecheck:be && echo '✅ All type checks passed!'",
    "typecheck:fe": "npm run type-check --workspace @app/renderer && echo '✅ Frontend type check passed'",
    "typecheck:be": "cd packages/api && npx tsc -p . --noEmit && echo '✅ Backend type check passed'",
    "rebuild:dev": "cd packages/api && npm rebuild",
    "db:cli": "cd packages/api && npm run db:cli",
    "db:exec": "cd packages/api && npm run db:exec",
    "db:reset": "cd packages/api && npm run db:reset",
    "db:script": "cd packages/api && npm run db:script",
    "compile": "npm run compile:actions && npm run compile:prompts && npm run compile:flows && npm run compile:library && npm run compile:notes",
    "compile:actions": "npm run compile:actions --workspace @app/default-setup",
    "compile:prompts": "npm run compile:prompts --workspace @app/default-setup",
    "compile:flows": "npm run compile:flows --workspace @app/default-setup",
    "compile:library": "npm run compile:library --workspace @app/default-setup",
    "compile:notes": "npm run compile:notes --workspace @app/default-setup",
    "build:speech-macos": "cd native/speech/macos && bash build.sh"
  },
  "devDependencies": {
    "@npmcli/map-workspaces": "4.0.2",
    "@playwright/test": "1.54.1",
    "@types/node": "24.1.0",
    "create-vite": "7.0.3",
    "electron": "37.2.4",
    "electron-builder": "26.0.12",
    "glob": "11.0.3",
    "playwright": "^1.54.1"
  },
  "dependencies": {
    "@app/main": "*",
    "@app/api": "*"
  }
}
