{
  "name": "agent-buddy",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "watch": "turbo watch dev",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:be": "pnpm --filter @abuddy/api test",
    "be": "pnpm --filter @abuddy/api build",
    "fe": "pnpm --filter @abuddy/web build",
    "electron": "pnpm --filter @abuddy/electron start",
    "electron:dev": "pnpm --filter @abuddy/electron dev",
    "electron:build": "pnpm --filter @abuddy/electron build",
    "electron:package": "pnpm --filter @abuddy/electron package",
    "electron:make": "pnpm --filter @abuddy/electron make"
  },
  "keywords": [],
  "author": "angel santiago",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "@types/node": "^22.15.17"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "npm-run-all": "^4.1.5"
  }
}
