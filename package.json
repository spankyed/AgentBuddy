{
  "name": "abuddy",
  "description": "Vibe working platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "author": {
    "email": "angel.santiago@tutanota.com",
    "name": "Angel Santiago",
    "url": "https://clientlabs.com"
  },
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "build": "npm run build -ws --if-present",
    "build-app": "sh build/build.sh",
    "run-app": "sh build/run_with_logs.sh",
    "compile": "npm run build && electron-builder build --config electron-builder.mjs",
    "test": "npx playwright test ./tests/e2e.spec.ts",
    "start": "npm run build:be && node packages/dev-mode.js",
    "start:no-build": "node packages/dev-mode.js",
    "build:be": "npm run build --workspace @app/api",
    "typecheck": "npm run typecheck:fe && npm run typecheck:be && echo '✅ All type checks passed!'",
    "typecheck:fe": "npm run type-check --workspace @app/renderer && echo '✅ Frontend type check passed'",
    "typecheck:be": "cd packages/api && npx tsc -p . --noEmit && echo '✅ Backend type check passed'",
    "create-renderer": "cd packages && node ./integrate-renderer/create-renderer.js",
    "integrate-renderer": "npm start --workspace @app/integrate-renderer",
    "init": "npm run create-renderer && npm run integrate-renderer && npm install",
    "rebuild": "cd packages/api && npx @electron/rebuild --force --module-dir . --electron-version 37.2.4 --arch arm64",
    "rebuild:dev": "cd packages/api && npm rebuild",
    "package": "npm run build && npm run package:mac",
    "package:mac": "electron-builder --mac --arm64",
    "package:all": "electron-builder --mac --win --linux"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@npmcli/map-workspaces": "4.0.2",
    "@playwright/test": "1.54.1",
    "@types/node": "24.1.0",
    "create-vite": "7.0.3",
    "electron": "37.2.4",
    "electron-builder": "26.0.12",
    "glob": "11.0.3",
    "playwright": "^1.54.1"
  },
  "dependencies": {
    "@app/main": "*",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.9.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0"
  }
}
