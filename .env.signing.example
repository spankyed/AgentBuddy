# macOS Code Signing & Notarization
# ===================================
# Set these env vars to enable signing and notarization during build.
# Without them, builds remain unsigned (fine for local dev).
#
# For CI: provide CSC_LINK (base64 .p12) and CSC_KEY_PASSWORD.
# For local: set CSC_LINK to a .p12 file path, or install a
# "Developer ID Application" certificate in your macOS Keychain.

# Disable code signing entirely (useful for local dev builds)
# CSC_IDENTITY_AUTO_DISCOVERY=false

# Code signing certificate
# Local: file path to .p12   CI: base64-encoded .p12
CSC_LINK=
CSC_KEY_PASSWORD=

# Apple Developer Team ID (required for notarization)
APPLE_TEAM_ID=

# App Store Connect API Key (required for notarization)
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_API_KEY=          # Path to .p8 private key file

# Distribution: upload artifacts to GitHub Releases as draft
# PUBLISH_TO_GITHUB=true
