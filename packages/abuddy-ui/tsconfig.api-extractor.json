{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    // @abuddy/sdk and @abuddy/ears resolve to their published declarations, not their source: API
    // Extractor analyses .d.ts files, and a dependency read as source is followed into it instead
    // of being reported as an import. Run npm run packages:build first.
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [".temp/api-types/**/*.d.ts"]
}
