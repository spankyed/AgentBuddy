{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "../default-setup/src/features/*/fe/**/*", "../default-setup/src/features/*/fe/**/*.vue", "../default-setup/src/shared/tiptap/**/*", "../default-setup/src/shared/tiptap/**/*.vue", "../default-setup/src/registries/plugins.ts", "../default-setup/src/registries/tiptap-plugins.ts", "../abuddy-sdk/src/fe/**/*", "../abuddy-sdk/src/fe/**/*.vue"],
  "exclude": ["src/**/__tests__/*", "src/core/types/generated/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/core/components/design/*": ["../abuddy-sdk/src/fe/design/*"],
      "@/core/components/tiptap/*": ["../abuddy-sdk/src/fe/components/tiptap/*"],
      "@/core/composables/useMenuState": ["../abuddy-sdk/src/fe/composables/useMenuState"],
      "@/core/composables/useContextMenu": ["../abuddy-sdk/src/fe/composables/useContextMenu"],
      "@/registries/*": ["../default-setup/src/registries/*"],
      "@/features/*": ["../default-setup/src/features/*"],
      "@/*": ["./src/*"]
    }
  }
}
