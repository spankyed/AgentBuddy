{
  "compilerOptions": {
    "noUnusedLocals": true,
    // Typechecking only, so the .tsbuildinfo is the whole point: a re-run with nothing changed reuses it
    // instead of reparsing, and `dep-files.integration.spec.ts` reads it to hold this leg's declared scope
    // to what the compiler reported reading. `incremental` works with `noEmit`; `composite` does not.
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/preload.tsbuildinfo",
    "customConditions": ["@abuddy/source"],
    "allowSyntheticDefaultImports": true,
    "module": "NodeNext",
    "target": "ESNext",
    "sourceMap": false,
    // The pack rule that every relative import names the file that is there applies here too, and this is
    // what lets tsc read a .ts specifier (nothing emits from this config: noEmit is set below)
    "allowImportingTsExtensions": true,
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["../*"]
    }
  },
  "include": ["src/**/*.ts", "../../types/**/*.d.ts"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts"]
}
