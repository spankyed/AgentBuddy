{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/registries/*": ["../default-setup/src/registries/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
