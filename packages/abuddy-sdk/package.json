{
  "name": "@abuddy/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./framework": "./src/framework/index.ts",
    "./helpers": "./src/helpers/index.ts",
    "./types": "./src/types/index.ts",
    "./ids": "./src/ids/index.ts",
    "./ears": "./src/ears/index.ts",
    "./fe": "./src/fe/index.ts",
    "./fe/design/*": "./src/fe/design/*",
    "./fe/composables/*": "./src/fe/composables/*",
    "./build": "./src/build/index.ts"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "xstate": "^5.19.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.4"
