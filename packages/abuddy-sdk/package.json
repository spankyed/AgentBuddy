{
  "name": "@abuddy/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "abuddy": "./bin/abuddy.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:build": "tsc -p tsconfig.api-extractor.json",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "schema:check": "tsx scripts/generate-schema.ts --check",
    "api:check": "npm run api:build && api-extractor run --config api-extractor.ears.json && api-extractor run --config api-extractor.types.json",
    "api:update": "npm run api:build && api-extractor run --config api-extractor.ears.json --local && api-extractor run --config api-extractor.types.json --local"
  },
  "exports": {
    ".": "./src/index.ts",
    "./designations": "./src/designations/index.ts",
    "./framework": "./src/framework/index.ts",
    "./helpers": "./src/helpers/index.ts",
    "./types": "./src/types/index.ts",
    "./ids": "./src/ids/index.ts",
    "./ears": "./src/ears/index.ts",
    "./ears/internals": "./src/ears/internals.ts",
    "./fe": "./src/fe/index.ts",
    "./fe/host": "./src/fe/host.ts",
    "./fe/pack-store": "./src/fe/pack-store.ts",
    "./fe/contributions": "./src/fe/contribution-types.ts",
    "./fe/design/ToastNotification.vue": "./src/fe/design/ToastNotification.vue",
    "./fe/design/ContextMenuPopup.vue": "./src/fe/design/ContextMenuPopup.vue",
    "./fe/design/*": "./src/fe/design/*",
    "./fe/composables/*": "./src/fe/composables/*",
    "./fe/layout/*": "./src/fe/layout/*",
    "./fe/utils/*": "./src/fe/utils/*",
    "./fe/utils/json-detection": "./src/fe/utils/json-detection.ts",
    "./fe/utils/path-truncation": "./src/fe/utils/path-truncation.ts",
    "./fe/components/*": "./src/fe/components/*",
    "./fe/components/node-styles": "./src/fe/components/node-styles.ts",
    "./fe/components/node-dimensions": "./src/fe/components/node-dimensions.ts",
    "./fe/components/monaco-config": "./src/fe/components/monaco-config.ts",
    "./fe/components/tiptap/*": "./src/fe/components/tiptap/*",
    "./fe/components/tiptap/editor-system": "./src/fe/components/tiptap/editor-system.ts",
    "./fe/components/tiptap/injection-keys": "./src/fe/components/tiptap/injection-keys.ts",
    "./fe/components/tiptap/registry": "./src/fe/components/tiptap/registry.ts",
    "./fe/components/tiptap/composables/*": "./src/fe/components/tiptap/composables/*",
    "./fe/components/tiptap/composables/createEditorKeyboard": "./src/fe/components/tiptap/composables/createEditorKeyboard.ts",
    "./fe/constants": "./src/fe/constants.ts",
    "./actions": "./src/actions/index.ts",
    "./artifacts": "./src/artifacts/index.ts",
    "./blocks": "./src/blocks/index.ts",
    "./steps": "./src/steps/index.ts",
    "./build": "./src/build/index.ts",
    "./build/shared-deps": "./src/build/shared-deps.ts",
    "./build/discover": "./src/build/discover.ts",
    "./runtime": "./src/runtime/index.ts",
    "./logger": "./src/logger/index.ts",
    "./rpc": "./src/rpc/index.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/pure": "./src/utils/pure.ts",
    "./utils/compare-versions": "./src/utils/compare-versions.ts",
    "./services": "./src/services/index.ts",
    "./inference": "./src/services/inference.ts",
    "./cron": "./src/utils/cron.ts",
    "./backup": "./src/backup/index.ts",
    "./seed": "./src/seed/index.ts",
    "./packs": "./src/packs/index.ts",
    "./persistence": "./src/persistence/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@guolao/vue-monaco-editor": "^1.5.5",
    "@playwright/test": ">=1.40.0",
    "@tiptap/core": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@tiptap/vue-3": "^3.20.1",
    "@vue-flow/core": "^1.0.0",
    "@xstate/vue": "^4.0.2",
    "ai": "^4.0.0",
    "elkjs": "^0.9.0",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^0.503.0",
    "monaco-editor": "^0.55.1",
    "reka-ui": "^2.2.1",
    "tiptap-markdown": "^0.9.0",
    "vue": "^3.0.0",
    "xstate": "^5.19.2"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/vue-3": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    },
    "@guolao/vue-monaco-editor": {
      "optional": true
    },
    "reka-ui": {
      "optional": true
    },
    "tiptap-markdown": {
      "optional": true
    },
    "lowlight": {
      "optional": true
    },
    "lucide-vue-next": {
      "optional": true
    },
    "@vue-flow/core": {
      "optional": true
    },
    "elkjs": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "xstate": "^5.19.2",
    "zod-to-json-schema": "^3.25.0"
  },
  "dependencies": {
    "@types/fs-extra": "^11.0.4",
    "fs-extra": "^11.4.0",
    "tsx": "^4.19.4",
    "zod": "^3.24.0"
  }
}
