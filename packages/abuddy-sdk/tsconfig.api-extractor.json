{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": ".temp/api-types",
    "outDir": ".temp/api-types",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/ears/internals.ts"]
}
