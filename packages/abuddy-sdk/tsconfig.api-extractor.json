{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    // @abuddy/ears resolves to its source (a dependency: not emitted here)
    "customConditions": ["@abuddy/source"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": ".temp/api-types",
    "outDir": ".temp/api-types",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
