{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    // @abuddy/ears resolves to its published declarations, not its source: API Extractor analyses
    // .d.ts files, and a dependency read as source is followed into it instead of being reported as
    // an import. Run npm run packages:build first.
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": ".temp/api-types",
    "outDir": ".temp/api-types",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
