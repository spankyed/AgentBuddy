{
  "compilerOptions": {
    "noUnusedLocals": true,
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/publish-checks.tsbuildinfo",
    "allowImportingTsExtensions": true,
    // Workspace @apack/* packages resolve to source (see their package.json exports)
    "customConditions": ["@apack/source"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
