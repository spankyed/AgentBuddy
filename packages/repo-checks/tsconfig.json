{
  "compilerOptions": {
    "noUnusedLocals": true,
    // Typechecking only, so the .tsbuildinfo is the whole point: a re-run with nothing changed reuses it
    // instead of reparsing. `incremental` works with `noEmit`; `composite` does not, which is why this
    // is not project references (docs/goals/goal-test-tiers.md).
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/repo-checks.tsbuildinfo",
    // The specs import `scripts/` and workspace @apackdev/* sources, which name .ts files
    "allowImportingTsExtensions": true,
    // Workspace @apackdev/* packages resolve to source (see their package.json exports)
    "customConditions": ["@apackdev/source"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts"]
}
