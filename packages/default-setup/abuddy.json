{
  "id": "default-setup",
  "name": "Default Setup",
  "version": "0.1.0",
  "builtIn": true,
  "description": "The official AgentBuddy starter pack. Provides core entity types, backend systems, services, frontend plugins, artifacts, seed data, message blocks, and default settings.",
  "hostVersion": ">=0.3.0",
  "license": "MIT",

  "entities": {
    "Relation": "Relation",
    "Agent": "Agent",
    "Thread": "Thread",
    "Message": "Message",
    "Artifact": "Artifact",
    "Brain": "Brain",
    "Flow": "Flow",
    "Node": "Node",
    "TNode": "TNode",
    "Document": "Document",
    "Collection": "Collection",
    "SearchIndex": "SearchIndex",
    "IndexedDoc": "IndexedDoc",
    "Terminal": "Terminal",
    "Directory": "Directory",
    "Settings": "Settings",
    "Secret": "Secret",
    "FAQ": "FAQ",
    "CalendarEvent": "CalendarEvent",
    "BrowserTab": "BrowserTab",
    "BrowserBookmark": "BrowserBookmark",
    "Note": "Note",
    "Action": "Action",
    "Prompt": "Prompt"
  },
  "relKinds": {
    "PARENT_OF": "parent_of",
    "CONTAINS": "contains",
    "REPLIED_TO": "replied_to",
    "HAS": "has",
    "BLOCKS": "blocks",
    "DEPENDS_ON": "depends_on",
    "RELATES_TO": "relates_to",
    "DUPLICATES": "duplicates",
    "TRANSITIONS_TO": "transitions_to",
    "EMITS": "emits",
    "INSTANCE_OF": "instance_of",
    "SPAWNED": "spawned",
    "TRACKED": "tracked"
  },
  "partitionPolicy": {
    "excludedEntityTypes": ["TNode"],
    "secretEntityTypes": ["Secret"]
  },

  "features": [
    {
      "id": "threads",
      "designation": "threads",
      "settings": "src/features/threads/settings.ts",
      "system": { "entry": "src/features/threads/be/system.ts", "exportName": "threadsEntry" },
      "plugin": { "entry": "src/features/threads/fe/plugin.ts", "label": "Threads", "icon": "BotMessageSquare" },
      "contributions": "src/features/threads/fe/contributions",
      "services": {
        "chat": "src/features/threads/be/services/chat",
        "artifact": "src/features/threads/be/services/artifact",
        "threads": "src/features/threads/be/services/threads"
      }
    },
    {
      "id": "code",
      "settings": "src/features/code/settings.ts",
      "system": { "entry": "src/features/code/be/system.ts", "exportName": "codeEntry" },
      "plugin": { "entry": "src/features/code/fe/plugin.ts", "label": "Code", "icon": "Code2" },
      "services": {
        "cli": "src/features/code/be/services/cli",
        "codex": "src/features/code/be/services/codex"
      }
    },
    {
      "id": "notes",
      "settings": "src/features/notes/settings.ts",
      "system": { "entry": "src/features/notes/be/system.ts", "exportName": "notesEntry" },
      "plugin": { "entry": "src/features/notes/fe/plugin.ts", "label": "Notes", "icon": "NotebookText" },
      "contributions": "src/features/notes/fe/contributions",
      "services": {}
    },
    {
      "id": "calendar",
      "settings": "src/features/calendar/settings.ts",
      "system": { "entry": "src/features/calendar/be/system.ts", "exportName": "calendarEntry" },
      "plugin": { "entry": "src/features/calendar/fe/plugin.ts", "label": "Calendar", "icon": "Calendar" },
      "services": {}
    },
    {
      "id": "browser",
      "designation": "browser",
      "settings": "src/features/browser/settings.ts",
      "system": { "entry": "src/features/browser/be/system.ts", "exportName": "browserEntry" },
      "plugin": { "entry": "src/features/browser/fe/plugin.ts", "label": "Browser", "icon": "Globe" },
      "services": {
        "browser": "src/features/browser/be/services/browser"
      }
    },
    {
      "id": "library",
      "settings": "src/features/library/settings.ts",
      "system": { "entry": "src/features/library/be/system.ts", "exportName": "libraryEntry" },
      "plugin": { "entry": "src/features/library/fe/plugin.ts", "label": "Library", "icon": "Library", "isPinned": true },
      "contributions": "src/features/library/fe/contributions",
      "services": {
        "library": "src/features/library/be/services/library"
      }
    },
    {
      "id": "flows",
      "settings": "src/features/flows/settings.ts",
      "typesEntry": "src/features/flows/be/config/types",
      "system": { "entry": "src/features/flows/be/system.ts", "exportName": "flowsEntry" },
      "plugin": { "entry": "src/features/flows/fe/plugin.ts", "label": "Flows", "icon": "Network", "isPinned": true },
      "services": {}
    },
    {
      "id": "actions",
      "settings": "src/features/actions/settings.ts",
      "system": { "entry": "src/features/actions/be/system.ts", "exportName": "actionsEntry", "outgoingEventsType": "OutgoingActionEvents" },
      "plugin": { "entry": "src/features/actions/fe/plugin.ts", "label": "Actions", "icon": "Play", "isPinned": true },
      "services": {
        "action": "src/features/actions/be/services/action"
      }
    },
    {
      "id": "prompts",
      "settings": "src/features/prompts/settings.ts",
      "system": { "entry": "src/features/prompts/be/system.ts", "exportName": "promptsEntry", "outgoingEventsType": "OutgoingPromptEvents" },
      "plugin": { "entry": "src/features/prompts/fe/plugin.ts", "label": "Prompts", "icon": "Sparkle", "isPinned": true },
      "services": {
        "prompt": "src/features/prompts/be/services/prompt"
      }
    },
    {
      "id": "brain",
      "designation": "brain",
      "settings": "src/features/brain/settings.ts",
      "system": { "entry": "src/features/brain/be/system.ts", "exportName": "brainEntry" },
      "plugin": { "entry": "src/features/brain/fe/plugin.ts", "label": "Brain", "icon": "Brain", "isPinned": true },
      "services": {
        "llm": "src/features/brain/be/services/llm",
        "brain": "src/features/brain/be/services/brain"
      }
    },
    {
      "id": "database",
      "settings": "src/features/database/settings.ts",
      "system": { "entry": "src/features/database/be/system.ts", "exportName": "databaseEntry" },
      "plugin": { "entry": "src/features/database/fe/plugin.ts", "label": "Database", "icon": "Database", "isPinned": true },
      "services": {
        "database": "src/features/database/be/services/database"
      }
    },
    {
      "id": "logs",
      "settings": "src/features/logs/settings.ts",
      "system": { "entry": "src/features/logs/be/system.ts", "exportName": "logsEntry" },
      "plugin": { "entry": "src/features/logs/fe/plugin.ts", "label": "Logs", "icon": "ScrollText", "isPinned": true },
      "services": {},
      "earlySystem": true
    },
    {
      "id": "settings",
      "designation": "settings",
      "settings": "src/features/settings/settings.ts",
      "system": { "entry": "src/features/settings/be/system.ts", "exportName": "settingsEntry" },
      "plugin": { "entry": "src/features/settings/fe/plugin.ts", "label": "Settings", "icon": "Settings" },
      "services": {
        "settings": "src/features/settings/be/services/settings"
      }
    }
  ],

  "packServices": {
    "textStream": "src/extensions/services/text-stream",
    "filesystem": "src/extensions/services/filesystem",
    "modelClient": "src/extensions/services/model-client",
    "openaiAuth": "src/extensions/services/openai-auth"
  },

  "defaultPlugin": "threads",

  "boot": {
    "earlySystem": "src/features/logs/be/system.ts",
    "createDefaultSettings": "src/features/settings/be/repository",
    "seed": "src/registries/seed/index.ts",
    "shutdown": "src/features/code/be/services/terminal.ts"
  },
  "steps": "src/extensions/steps/register.ts",
  "artifacts": "src/extensions/artifacts/register.ts",
  "blocks": "src/extensions/blocks/register.ts",
  "migrations": "src/migrations/index.ts",

  "seeds": {
    "actions": "src/seeds/actions",
    "prompts": "src/seeds/prompts",
    "flows": "src/seeds/flows",
    "library": "src/seeds/library",
    "notes": "src/seeds/notes",
    "faqs": "src/seeds/faqs",
    "settings": "src/seeds/default-settings.ts"
  }
}
