{
  "$schema": "../abuddy-sdk/abuddy.schema.json",
  "id": "default-setup",
  "name": "Default Setup",
  "version": "0.1.0",
  "builtIn": true,
  "description": "The official AgentBuddy starter pack. Provides core entity types, backend systems, services, frontend plugins, artifacts, content data, message blocks, and default settings.",
