{
  "$schema": "../abuddy-sdk/abuddy.schema.json",
  "id": "default-setup",
  "name": "Default Setup",
  "version": "0.1.0",
  "builtIn": true,
  "description": "The official AgentBuddy starter pack. Provides core entity types, backend systems, services, frontend plugins, artifacts, seed data, message blocks, and default settings.",
  "hostVersion": ">=0.3.0",
  "license": "MIT",
  "entities": {
    "Agent": "Agent",
    "Thread": "Thread",
    "Message": "Message",
    "Artifact": "Artifact",
    "Brain": "Brain",
    "SearchIndex": "SearchIndex",
    "IndexedDoc": "IndexedDoc",
    "Terminal": "Terminal",
    "Directory": "Directory",
    "FAQ": "FAQ",
    "BrowserTab": "BrowserTab",
    "BrowserBookmark": "BrowserBookmark",
    "Document": "Document",
    "Collection": "Collection",
    "Note": "Note"
  },
  "relKinds": {
    "PARENT_OF": "parent_of",
    "REPLIED_TO": "replied_to",
    "HAS": "has",
    "BLOCKS": "blocks",
    "DEPENDS_ON": "depends_on",
    "RELATES_TO": "relates_to",
    "DUPLICATES": "duplicates",
    "EMITS": "emits"
  },
  "partitionPolicy": {
    "excludedEntityTypes": [],
    "secretEntityTypes": []
  },
  "features": [
    {
      "id": "threads",
      "designation": "threads",
      "settings": "src/features/threads/settings.ts",
      "system": {
        "entry": "src/features/threads/be/system.ts"
      },
      "plugin": {
        "entry": "src/features/threads/fe/plugin.ts",
        "label": "Threads",
        "icon": "BotMessageSquare"
      },
      "contributions": "src/features/threads/fe/contributions",
      "services": {
        "chat": "src/features/threads/be/services/chat",
        "artifact": "src/features/threads/be/services/artifact",
        "threads": "src/features/threads/be/services/threads"
      },
      "repositories": {
        "threadQueries": "src/features/threads/be/repository/index.ts#threadQueries",
        "threadCommands": "src/features/threads/be/repository/index.ts#threadCommands",
        "chatQueries": "src/features/threads/be/repository/index.ts#chatQueries",
        "chatCommands": "src/features/threads/be/repository/index.ts#chatCommands"
      }
    },
    {
      "id": "code",
      "settings": "src/features/code/settings.ts",
      "system": {
        "entry": "src/features/code/be/system.ts"
      },
      "plugin": {
        "entry": "src/features/code/fe/plugin.ts",
        "label": "Code",
        "icon": "Code2"
      },
      "services": {
        "cli": "src/features/code/be/services/cli",
        "codex": "src/features/code/be/services/codex"
      },
      "repositories": {
        "terminalQueries": "src/features/code/be/repository/index.ts#terminalQueries",
        "terminalCommands": "src/features/code/be/repository/index.ts#terminalCommands"
      }
    },
    {
      "id": "notes",
      "settings": "src/features/notes/settings.ts",
      "system": {
        "entry": "src/features/notes/be/system.ts"
      },
      "plugin": {
        "entry": "src/features/notes/fe/plugin.ts",
        "label": "Notes",
        "icon": "NotebookText"
      },
      "contributions": "src/features/notes/fe/contributions",
      "services": {},
      "repositories": {
        "noteQueries": "src/features/notes/be/repository/index.ts#noteQueries",
        "noteCommands": "src/features/notes/be/repository/index.ts#noteCommands"
      }
    },
    {
      "id": "browser",
      "designation": "browser",
      "settings": "src/features/browser/settings.ts",
      "system": {
        "entry": "src/features/browser/be/system.ts"
      },
      "plugin": {
        "entry": "src/features/browser/fe/plugin.ts",
        "label": "Browser",
        "icon": "Globe"
      },
      "services": {
        "browser": "src/features/browser/be/services/browser"
      },
      "repositories": {
        "browserQueries": "src/features/browser/be/repository/index.ts#browserQueries",
        "browserCommands": "src/features/browser/be/repository/index.ts#browserCommands"
      }
    },
    {
      "id": "library",
      "settings": "src/features/library/settings.ts",
      "system": {
        "entry": "src/features/library/be/system.ts"
      },
      "plugin": {
        "entry": "src/features/library/fe/plugin.ts",
        "label": "Library",
        "icon": "Library",
        "isPinned": true
      },
      "contributions": "src/features/library/fe/contributions",
      "services": {
        "library": "src/features/library/be/services/library"
      },
      "repositories": {
        "libraryQueries": "src/features/library/be/repository/index.ts#libraryQueries",
        "libraryCommands": "src/features/library/be/repository/index.ts#libraryCommands"
      }
    },
    {
      "id": "flows",
      "settings": "src/features/flows/settings.ts",
      "typesEntry": "src/features/flows/be/types",
      "system": {
        "entry": "src/features/flows/be/system.ts"
      },
      "plugin": {
        "entry": "src/features/flows/fe/plugin.ts",
        "label": "Flows",
        "icon": "Network",
        "isPinned": true
      },
      "services": {},
      "repositories": {
        "flowsQueries": "src/features/flows/be/repository/index.ts#flowsQueries",
        "flowsCommands": "src/features/flows/be/repository/index.ts#flowsCommands"
      }
    },
    {
      "id": "actions",
      "settings": "src/features/actions/settings.ts",
      "system": {
        "entry": "src/features/actions/be/system.ts",
        "outgoingEventsType": "OutgoingActionEvents",
        "sendsTo": [
          "flows"
        ]
      },
      "plugin": {
        "entry": "src/features/actions/fe/plugin.ts",
        "label": "Actions",
        "icon": "Play",
        "isPinned": true
      },
      "services": {
        "action": "src/features/actions/be/services/action"
      },
      "repositories": {
        "actionQueries": "src/features/actions/be/repository/index.ts#actionQueries",
        "actionCommands": "src/features/actions/be/repository/index.ts#actionCommands"
      }
    },
    {
      "id": "prompts",
      "settings": "src/features/prompts/settings.ts",
      "system": {
        "entry": "src/features/prompts/be/system.ts",
        "outgoingEventsType": "OutgoingPromptEvents"
      },
      "plugin": {
        "entry": "src/features/prompts/fe/plugin.ts",
        "label": "Prompts",
        "icon": "Sparkle",
        "isPinned": true
      },
      "services": {
        "prompt": "src/features/prompts/be/services/prompt"
      },
      "repositories": {
        "promptQueries": "src/features/prompts/be/repository/index.ts#promptQueries",
        "promptCommands": "src/features/prompts/be/repository/index.ts#promptCommands"
      }
    },
    {
      "id": "brain",
      "designation": "brain",
      "settings": "src/features/brain/settings.ts",
      "system": {
        "entry": "src/features/brain/be/system.ts"
      },
      "plugin": {
        "entry": "src/features/brain/fe/plugin.ts",
        "label": "Brain",
        "icon": "Brain",
        "isPinned": true
      },
      "services": {
        "llm": "src/features/brain/be/services/llm",
        "brain": "src/features/brain/be/services/brain"
      },
      "repositories": {
        "brainQueries": "src/features/brain/be/repository/index.ts#brainQueries",
        "brainCommands": "src/features/brain/be/repository/index.ts#brainCommands"
      }
    },
    {
      "id": "database",
      "settings": "src/features/database/settings.ts",
      "system": {
        "entry": "src/features/database/be/system.ts"
      },
      "plugin": {
        "entry": "src/features/database/fe/plugin.ts",
        "label": "Database",
        "icon": "Database",
        "isPinned": true
      },
      "services": {
        "database": "src/features/database/be/services/database"
      }
    },
    {
      "id": "logs",
      "designation": "logs",
      "settings": "src/features/logs/settings.ts",
      "system": {
        "entry": "src/features/logs/be/system.ts"
      },
      "plugin": {
        "entry": "src/features/logs/fe/plugin.ts",
        "label": "Logs",
        "icon": "ScrollText",
        "isPinned": true
      },
      "services": {},
      "earlySystem": true
    },
    {
      "id": "settings",
      "designation": "settings",
      "settings": "src/features/settings/settings.ts",
      "system": {
        "entry": "src/features/settings/be/system.ts",
        "sendsTo": [
          "application"
        ]
      },
      "plugin": {
        "entry": "src/features/settings/fe/plugin.ts",
        "label": "Settings",
        "icon": "Settings"
      },
      "services": {
        "settings": "src/features/settings/be/services/settings"
      },
      "repositories": {
        "settingsQueries": "src/features/settings/be/repository/index.ts#settingsQueries",
        "settingsCommands": "src/features/settings/be/repository/index.ts#settingsCommands",
        "secretsQueries": "src/features/settings/be/secrets/repository.ts#secretsQueries",
        "secretsCommands": "src/features/settings/be/secrets/repository.ts#secretsCommands"
      }
    }
  ],
  "packServices": {
    "textStream": "src/extensions/services/text-stream",
    "filesystem": "src/extensions/services/filesystem",
    "modelClient": "src/extensions/services/model-client",
    "openaiAuth": "src/extensions/services/openai-auth"
  },
  "defaultPlugin": "threads",
  "boot": {
    "earlySystem": "src/features/logs/be/system.ts",
    "hooks": "src/features/hooks.ts",
    "seed": {
      "actions": "src/seeds/actions",
      "prompts": "src/seeds/prompts",
      "flows": "src/seeds/flows",
      "library": {
        "path": "src/seeds/library",
        "format": "library"
      },
      "notes": {
        "path": "src/seeds/notes",
        "format": "notes"
      },
      "faqs": {
        "path": "src/seeds/faqs",
        "format": "faqs"
      },
      "settings": "src/seeds/default-settings.ts"
    },
    "seedPolicy": {
      "skipAtBoot": [
        "settings"
      ],
      "skipAfterOnboarding": [
        "notes"
      ]
    }
  },
  "entityShapes": {
    "Thread": {
      "source": "src/features/threads/be/types.ts",
      "type": "ThreadEntity"
    },
    "Message": {
      "source": "src/features/threads/be/types.ts",
      "type": "MessageEntity"
    },
    "Artifact": {
      "source": "src/features/threads/be/types.ts",
      "type": "ArtifactEntity"
    },
    "Terminal": {
      "source": "src/features/code/be/repository/index.ts",
      "type": "TerminalEntity"
    },
    "BrowserTab": {
      "source": "src/features/browser/be/types.ts",
      "type": "BrowserTabEntity"
    },
    "BrowserBookmark": {
      "source": "src/features/browser/be/types.ts",
      "type": "BrowserBookmarkEntity"
    },
    "Document": {
      "source": "src/features/library/be/types.ts",
      "type": "DocumentEntity"
    },
    "Collection": {
      "source": "src/features/library/be/types.ts",
      "type": "CollectionEntity"
    },
    "Note": {
      "source": "src/features/notes/be/types.ts",
      "type": "NoteEntity"
    }
  },
  "seedFormats": {
    "notes": {
      "format": "markdown-tree",
      "entity": "Note",
      "identity": [
        "title",
        "parent"
      ],
      "tree": {
        "branch": "index.md",
        "relKind": "contains"
      },
      "fields": {
        "title": {
          "from": "frontmatter.title",
          "default": "filename",
          "type": "string"
        },
        "noteType": {
          "from": "frontmatter.type",
          "default": "document"
        },
        "icon": {
          "from": "frontmatter.icon",
          "default": null,
          "type": "string"
        },
        "favorite": {
          "from": "frontmatter.favorite",
          "default": false
        },
        "hideCompletedChildren": {
          "from": "frontmatter.hideCompletedChildren",
          "default": false
        },
        "completed": {
          "from": "frontmatter.completed",
          "default": false
        },
        "content": {
          "from": "body"
        }
      }
    },
    "library": {
      "compiler": "src/seeds/compilers/library.ts",
      "entity": [
        "Collection",
        "Document"
      ],
      "identity": [
        "name"
      ],
      "media": "media"
    },
    "faqs": {
      "compiler": "src/seeds/compilers/faqs.ts"
    }
  },
  "seedHooks": {
    "Collection": "src/seeds/hooks/library.ts#collectionSeedHooks",
    "Document": "src/seeds/hooks/library.ts#documentSeedHooks",
    "Note": "src/seeds/hooks/notes.ts#noteSeedHooks"
  },
  "steps": {
    "register": "src/extensions/steps/register.ts",
    "build": "src/extensions/steps/build.ts",
    "definitions": [
      {
        "type": "action",
        "path": "src/extensions/steps/action",
        "dsl": {
          "primaryField": "action"
        }
      },
      {
        "type": "llm",
        "path": "src/extensions/steps/llm",
        "dsl": {
          "primaryField": "prompt"
        }
      },
      {
        "type": "fire",
        "path": "src/extensions/steps/fire",
        "dsl": {
          "primaryField": "event"
        }
      },
      {
        "type": "subflow",
        "path": "src/extensions/steps/subflow",
        "dsl": {
          "primaryField": "flow"
        }
      },
      {
        "type": "query",
        "path": "src/extensions/steps/query",
        "dsl": {
          "primaryField": "prompt"
        }
      },
      {
        "type": "create",
        "path": "src/extensions/steps/create",
        "dsl": {
          "primaryField": "entity"
        }
      },
      {
        "type": "update",
        "path": "src/extensions/steps/update",
        "dsl": {
          "primaryField": "target"
        }
      },
      {
        "type": "transform",
        "path": "src/extensions/steps/transform",
        "dsl": {
          "primaryField": "script"
        }
      },
      {
        "type": "keep_alive",
        "path": "src/extensions/steps/keep-alive",
        "dsl": {}
      },
      {
        "type": "kill",
        "path": "src/extensions/steps/kill",
        "dsl": {
          "defaultLabel": "Kill Flow"
        }
      },
      {
        "type": "switch",
        "path": "src/extensions/steps/switch",
        "dsl": {
          "custom": true
        }
      },
      {
        "type": "schedule",
        "path": "src/extensions/steps/schedule",
        "kind": "trigger"
      },
      {
        "type": "listener",
        "path": "src/extensions/steps/listener",
        "kind": "trigger"
      }
    ]
  },
  "artifacts": "src/extensions/artifacts/register.ts",
  "blocks": "src/extensions/blocks/register.ts",
  "fe": {
    "tiptapPlugins": "src/extensions/tiptap/index.ts",
    "appExtensions": {
      "welcome": "src/extensions/Welcome.vue"
    }
  },
  "migrations": "src/migrations/index.ts",
  "dsl": {
    "action": {
      "entry": "src/defs/action.ts",
      "targets": [
        "monaco"
      ],
      "prefix": "action:",
      "globals": {
        "services": "typeof _dsl.services",
        "z": "typeof _dsl.z",
        "flowId": "string"
      }
    },
    "prompt": {
      "entry": "src/defs/prompt.ts",
      "targets": [
        "monaco"
      ],
      "prefix": "prompt:",
      "globals": {
        "usePrompt": "typeof _dsl.usePrompt"
      }
    },
    "database": {
      "entry": "src/defs/database.ts",
      "targets": [
        "monaco"
      ],
      "prefix": "database:",
      "globals": {
        "EARS": "typeof _dsl.EARS",
        "qx": "typeof _dsl.qx",
        "tx": "typeof _dsl.tx",
        "bp": "typeof _dsl.bp",
        "spawn": "typeof _dsl.spawn",
        "getSchemaStats": "typeof _dsl.getSchemaStats",
        "isEntity": "typeof _dsl.isEntity"
      }
    }
  }
}
