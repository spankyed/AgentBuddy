  "boot": {
    "hooks": "src/features/hooks.ts"
  },
  "content": {
    "sources": {
      "actions": {
        "path": "src/content/actions",
        "onUserEdit": "offer"
      },
      "prompts": {
        "path": "src/content/prompts",
        "onUserEdit": "offer"
      },
      "flows": {
        "path": "src/content/flows",
        "onUserEdit": "offer"
      },
      "library": {
        "path": "src/content/library",
        "format": "library"
      },
      "notes": {
        "path": "src/content/notes",
        "format": "notes"
      }
    },
    "datasets": {
      "faqs": {
        "path": "src/content/faqs",
        "format": "faqs"
      }
    },
    "formats": {
      "notes": {
        "format": "markdown-tree",
        "entity": "Note",
        "identity": [
          "title",
          "parent"
        ],
        "tree": {
          "branch": "index.md",
          "relKind": "contains"
        },
        "fields": {
          "title": {
            "from": "frontmatter.title",
            "default": "filename",
            "type": "string"
          },
          "noteType": {
            "from": "frontmatter.type"
          },
          "icon": {
            "from": "frontmatter.icon",
            "default": null,
            "type": "string"
          },
          "favorite": {
            "from": "frontmatter.favorite"
          },
          "hideCompletedChildren": {
            "from": "frontmatter.hideCompletedChildren"
          },
          "completed": {
            "from": "frontmatter.completed"
          },
          "content": {
            "from": "body"
          }
        }
      },
      "library": {
        "compiler": "src/content/_compilers/library.ts",
        "entity": [
          "Collection",
          "Document"
        ],
        "identity": [
          "name"
        ],
        "media": "media"
      },
      "faqs": {
        "compiler": "src/content/_compilers/faqs.ts"
      }
    },
    "writers": {
      "Collection": "src/content/writers/library.ts#collectionWriter",
      "Document": "src/content/writers/library.ts#documentWriter",
      "Note": "src/content/writers/notes.ts#noteWriter"
    }
  },
  "entityShapes": {
    "Thread": {
      "source": "src/features/threads/be/types.ts",
      "type": "ThreadEntity"
    },
    "Message": {
      "source": "src/features/threads/be/types.ts",
      "type": "MessageEntity"
    },
    "Artifact": {
      "source": "src/features/threads/be/types.ts",
      "type": "ArtifactEntity"
    },
    "Terminal": {
      "source": "src/features/code/be/repository/index.ts",
      "type": "TerminalEntity"
    },
    "BrowserTab": {
      "source": "src/features/browser/be/types.ts",
      "type": "BrowserTabEntity"
    },
    "BrowserBookmark": {
      "source": "src/features/browser/be/types.ts",
      "type": "BrowserBookmarkEntity"
    },
    "Document": {
      "source": "src/features/library/be/types.ts",
      "type": "DocumentEntity"
    },
    "Collection": {
      "source": "src/features/library/be/types.ts",
      "type": "CollectionEntity"
    },
    "Note": {
      "source": "src/features/notes/be/types.ts",
      "type": "NoteEntity"
    }
