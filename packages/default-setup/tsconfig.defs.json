{
  "compilerOptions": {
    // Workspace @abuddy/* packages resolve to source (see their package.json exports)
    "customConditions": ["@abuddy/source"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "composite": false,
    "baseUrl": ".",
    "paths": {
      // rollup-defs.config.mjs inlines SDK types into the self-contained Monaco declarations
      "@abuddy/sdk": ["../abuddy-sdk/src/index.ts"],
      "@abuddy/sdk/inference": ["../abuddy-sdk/src/services/inference.ts"],
      "@abuddy/sdk/*": ["../abuddy-sdk/src/*/index.ts", "../abuddy-sdk/src/*"],
      "@/__generated__/*": ["./src/__generated__/*"],
      "@/features/*": ["./src/features/*"],
      "@/extensions/*": ["./src/extensions/*"]
    }
  },
  "include": [
    "src/defs/**/*.ts"
  ]
}
