{
  "compilerOptions": {
    // Workspace @abuddy/* packages resolve to source (see their package.json exports)
    "customConditions": ["@abuddy/source"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    // zod's z.infer degrades to all-optional without this, and boolean-literal
    // discriminants stop narrowing. Both are load-bearing here.
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/__generated__/*": ["./src/__generated__/*"],
      "#generated/*": ["./src/__generated__/*"],
      "@/registries/*": ["./src/registries/*"],
      "@/features/*": ["./src/features/*"],
      "@/extensions/*": ["./src/extensions/*"]
    }
  },
  // .vue files are checked by vue-tsc (npm run typecheck). src/defs/ (the Monaco DSL surfaces) is
  // checked here too; rollup-defs.config.mjs builds it separately under tsconfig.defs.json.
  "include": [
    "src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"
  ],
  "exclude": [
    // [SEARCH_INDEX_FF] The dormant library search index: these import fastembed and usearch, which
    // no workspace installs. src/features/library/be/search-index/README.md says how to turn it on.
    "src/features/library/be/search-index/repository.ts",
    "src/features/library/be/search-index/service.ts",
    "src/features/library/be/search-index/config/fastembed-mapping.ts"
  ]
}
