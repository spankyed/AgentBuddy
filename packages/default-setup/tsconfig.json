{
  "compilerOptions": {
    // Typechecking only, so the .tsbuildinfo is the whole point: a re-run with nothing changed reuses it
    // instead of reparsing. `incremental` works with `noEmit`; `composite` does not, which is why this
    // is not project references (docs/goals/goal-test-tiers.md).
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/default-setup.tsbuildinfo",
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    // zod's z.infer degrades to all-optional without this, and boolean-literal
    // discriminants stop narrowing. Both are load-bearing here.
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/__generated__/*": ["./src/__generated__/*"],
      "#generated/*": ["./src/__generated__/*"],
      "@/features/*": ["./src/features/*"],
      "@/extensions/*": ["./src/extensions/*"],
      "@/app-settings/*": ["./src/app-settings/*"]
    }
  },
  // .vue files are checked by vue-tsc (npm run typecheck). src/defs/ (the Monaco DSL surfaces) is
  // checked here too; abuddy build bundles their declarations for the Monaco editors.
  "include": [
    "src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"
  ],
  "exclude": [
    // [SEARCH_INDEX_FF] The dormant library search index: these import fastembed and usearch, which
    // no workspace installs. src/features/library/be/search-index/README.md says how to turn it on.
    "src/features/library/be/search-index/repository.ts",
    "src/features/library/be/search-index/service.ts",
    "src/features/library/be/search-index/config/fastembed-mapping.ts"
  ]
}
