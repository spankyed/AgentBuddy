{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@abuddy/sdk": ["../abuddy-sdk/src/index.ts"],
      "@abuddy/sdk/*": ["../abuddy-sdk/src/*/index.ts", "../abuddy-sdk/src/*"],
      "@/registries/*": ["./src/registries/*"],
      "@/plugins/*": ["./src/plugins/*"],
      "@/steps/*": ["./src/steps/*"],
      "@/*": ["../api/src/*"],
      "@app/api/dist/*": ["../api/dist/*"]
    }
  },
  "include": [
    "src/**/*.ts", "tests/**/*.ts"
  ],
  "exclude": [
    "src/**/*.example.ts",
    "src/_examples/**"
  ]
}
