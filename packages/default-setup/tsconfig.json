{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@abuddy/sdk": ["../abuddy-sdk/src/index.ts"],
      "@abuddy/sdk/*": ["../abuddy-sdk/src/*/index.ts", "../abuddy-sdk/src/*"],
      "@/__generated__/*": ["./src/__generated__/*"],
      "@/registries/*": ["./src/registries/*"],
      "@/features/*": ["./src/features/*"],
      "@/steps/*": ["./src/steps/*"],
      "@/blocks/*": ["./src/blocks/*"],
      "@/artifacts/*": ["./src/artifacts/*"]
    }
  },
  "include": [
    "src/**/*.ts", "tests/**/*.ts"
  ],
  "exclude": [
    "src/**/*.example.ts",
    "src/_examples/**"
  ]
}
