{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts", "build/**/*.ts", "defs/**/*.ts"
  ],
  "exclude": [
    "src/**/*.example.ts",
    "src/_examples/**"
  ]
}
