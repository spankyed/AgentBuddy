{
  "Every": {
    "root": true,
    "tracks": [
      {
        "event": "flow.entry",
        "exits": [
          [
            {
              "type": "keep_alive",
              "label": "Keep Alive"
            }
          ]
        ],
        "label": "Flow Entry"
      },
      {
        "event": "go",
        "exits": [
          [
            {
              "type": "action",
              "action": "send",
              "description": "d",
              "map": {
                "to": "$.event.data.to"
              },
              "params": {
                "x": 1
              }
            },
            {
              "type": "action",
              "mode": "code",
              "actionFn": "return ctx.a + 1",
              "label": "compute"
            },
            {
              "type": "llm",
              "prompt": "sum",
              "temperature": 0.2,
              "maxTokens": 10
            },
            {
              "type": "query",
              "prompt": "what?",
              "label": "Query",
              "as": "results"
            },
            {
              "type": "create",
              "entity": "Note",
              "label": "Create Note",
              "params": {
                "content": "c"
              }
            },
            {
              "type": "update",
              "target": "$.note",
              "label": "Update",
              "params": {
                "content": "c"
              },
              "onMissing": "ignore"
            },
            {
              "type": "transform",
              "script": "return 1",
              "label": "Transform",
              "outputType": "text"
            },
            {
              "type": "fire",
              "event": "ping",
              "scope": "global",
              "payload": {
                "a": 1
              }
            },
            {
              "type": "subflow",
              "flow": "Every",
              "inherit": false
            },
            {
              "type": "switch",
              "conditions": [
                {
                  "if": "ok == true",
                  "steps": [
                    {
                      "type": "kill",
                      "label": "Kill Flow"
                    }
                  ]
                }
              ],
              "label": "Switch",
              "else": [
                {
                  "type": "keep_alive",
                  "label": "Keep Alive"
                }
              ]
            }
          ]
        ],
        "label": "go"
      }
    ]
  }
}
