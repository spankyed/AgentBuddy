{
  "name": "@app/default-setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#generated/*": "./src/__generated__/*"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "pretest": "tsx ../../scripts/ensure-packages-built.ts",
    "test": "vitest run",
    "prepare": "abuddy generate-entries",
    "generate:entries": "abuddy generate-entries",
    "build": "abuddy build && node --import tsx --conditions=@abuddy/source dev-build.mjs",
    "build:dev": "abuddy build --skip-fe",
    "facade:check": "tsx ../../scripts/facade-report.ts .",
    "facade:update": "tsx ../../scripts/facade-report.ts . --local",
    "lint": "oxlint . -D correctness --ignore-path .gitignore --fix",
    "lint:check": "oxlint . -D correctness --ignore-path .gitignore"
  },
  "dependencies": {
    "@abuddy/ears": "*",
    "@abuddy/sdk": "*",
    "@abuddy/ui": "*",
    "@antv/g6": "^5.0.48",
    "@floating-ui/vue": "^1.1.11",
    "@leeoniya/ufuzzy": "^1.0.18",
    "@vscode/ripgrep": "^1.17.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/minimap": "^1.5.3",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "croner": "^10.0.1",
    "elkjs": "^0.9.0",
    "node-pty": "^1.0.0",
    "vue": "^3.5.18",
    "vue-arrange": "^1.5.0"
  },
  "devDependencies": {
    "@abuddy/testing": "*",
    "@types/node": "^25.5.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4",
    "zod": "^3.25.76"
  }
}
