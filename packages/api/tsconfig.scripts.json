{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@abuddy/sdk": ["../abuddy-sdk/src/index.ts"],
      "@abuddy/sdk/*": ["../abuddy-sdk/src/*/index.ts", "../abuddy-sdk/src/*"],
      "@abuddy/host/*": ["../abuddy-host/src/*/index.ts", "../abuddy-host/src/*"],
      "@/*": ["src/*"]
