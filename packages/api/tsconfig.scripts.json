{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Its own, not tsconfig.json's inherited one: typecheck:be runs three tsc passes over this package
    // and one shared .tsbuildinfo would have them overwrite each other, so none of them stays warm
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/api-scripts.tsbuildinfo",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // The one-off scripts (scripts/db/fix-prod-upgrade.ts), typechecked by npm run typecheck:be (they import the API's src)
  "include": ["scripts/**/*.ts", "src/env.d.ts"],
  "exclude": []
}
