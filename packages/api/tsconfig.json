{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@/registries/*": ["../default-setup/src/registries/*"],
      "@/features/*": ["../default-setup/src/features/*"],
      "@/shared-services/*": ["../default-setup/src/shared/services/*"],
      "@/*": ["src/*"]
    },
    "moduleResolution": "node",
    "module": "commonjs",
    "allowImportingTsExtensions": false
  },
  "include": ["src"],
  // [SEARCH_INDEX_FF] search-index excluded because its deps (fastembed, usearch, openai) are uninstalled.
  // To re-enable: npm i fastembed@^1.14.1 usearch@^2.15.2 openai@^4.100.0 --workspace @app/api
  // then remove "src/systems/library/search-index/**/*" from the exclude array below.
  "exclude": ["scripts/**/*", "../default-setup/src/features/library/be/search-index/**/*"]
}
