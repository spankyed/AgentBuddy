{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,          // ← emit types
    "declarationMap": true,
    "emitDeclarationOnly": false,   // emit JS files too
    "noEmit": false,               // override base config
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
    },
    "moduleResolution": "node",
    "module": "commonjs",
    "allowImportingTsExtensions": false
  },
  "include": ["src"],
  // [SEARCH_INDEX_FF] search-index excluded because its deps (fastembed, usearch, openai) are uninstalled.
  // To re-enable: npm i fastembed@^1.14.1 usearch@^2.15.2 openai@^4.100.0 --workspace @app/api
  // then remove "src/systems/library/search-index/**/*" from the exclude array below.
  "exclude": ["src/cli/**/*", "scripts/**/*", "src/systems/library/search-index/**/*"]
}