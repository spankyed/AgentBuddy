{
  "compilerOptions": {
    // Typechecking only, so the .tsbuildinfo is the whole point: a re-run with nothing changed reuses it
    // instead of reparsing. `incremental` works with `noEmit`; `composite` does not, which is why this
    // is not project references (docs/goals/goal-test-tiers.md).
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuildinfo/api.tsbuildinfo",
    // Workspace @abuddy/* packages resolve to source (see their package.json exports)
    "customConditions": ["@abuddy/source"],
    // Their sources import .ts files by name; this config emits, which requires rewriteRelativeImportExtensions too
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    // tsup bundles the server as ESM
    "moduleResolution": "bundler",
    "module": "esnext"
  },
  "include": ["src"],
  "exclude": ["scripts/**/*"]
}
