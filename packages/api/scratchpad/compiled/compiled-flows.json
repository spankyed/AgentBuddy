{
  "Analysis Flow": [
    {
      "event": "flow.entry",
      "label": "Flow Entry",
      "exits": [
        [
          {
            "type": "action",
            "action": "Analyze Text",
            "label": "analyze"
          },
          {
            "type": "fire",
            "event": "analysis.complete",
            "label": "notify"
          }
        ]
      ]
    }
  ],
  "Support Flow": [
    {
      "event": "flow.entry",
      "label": "Flow Entry",
      "exits": [
        [
          {
            "type": "action",
            "action": "Analyze Text",
            "label": "classify"
          },
          {
            "type": "switch",
            "conditions": [
              {
                "if": "$.intent == 'question'",
                "steps": [
                  {
                    "type": "action",
                    "action": "db query",
                    "label": "lookup"
                  }
                ]
              },
              {
                "if": "$.intent == 'request'",
                "steps": [
                  {
                    "type": "action",
                    "action": "db query",
                    "label": "onboard"
                  }
                ]
              }
            ],
            "else": [
              {
                "type": "fire",
                "event": "support.escalated",
                "label": "escalate"
              }
            ]
          }
        ]
      ]
    }
  ],
  "Monitor Flow": [
    {
      "event": "flow.entry",
      "label": "Flow Entry",
      "exits": [
        [
          {
            "type": "action",
            "action": "Analyze Text",
            "label": "init"
          },
          {
            "type": "keep_alive"
          }
        ]
      ]
    },
    {
      "event": "user.message",
      "label": "Handle Message",
      "exits": [
        [
          {
            "type": "action",
            "action": "db query",
            "label": "process"
          },
          {
            "type": "fire",
            "event": "message.processed"
          }
        ]
      ]
    },
    {
      "event": "user.disconnect",
      "label": "Handle Disconnect",
      "exits": [
        [
          {
            "type": "fire",
            "event": "session.ended",
            "label": "end"
          }
        ]
      ]
    }
  ],
  "Notification Flow": [
    {
      "event": "flow.entry",
      "label": "Flow Entry",
      "exits": [
        [
          {
            "type": "action",
            "action": "db query",
            "label": "init"
          },
          {
            "type": "keep_alive"
          }
        ]
      ]
    },
    {
      "event": "order.placed",
      "label": "Handle Order",
      "exits": [
        [
          {
            "type": "action",
            "action": "db query",
            "label": "email"
          },
          {
            "type": "fire",
            "event": "email.sent",
            "label": "email sent"
          }
        ],
        [
          {
            "type": "action",
            "action": "db query",
            "label": "inventory"
          },
          {
            "type": "fire",
            "event": "inventory.updated",
            "label": "inventory updated"
          }
        ]
      ]
    }
  ],
  "Onboarding Flow": [
    {
      "event": "flow.entry",
      "label": "Flow Entry",
      "exits": [
        [
          {
            "type": "action",
            "action": "Init Onboarding",
            "label": "setup onboarding"
          },
          {
            "type": "keep_alive"
          }
        ]
      ]
    },
    {
      "event": "interactive.message.response",
      "label": "Route Response",
      "exits": [
        [
          {
            "type": "action",
            "action": "Handle Onboarding Response",
            "label": "advance step",
            "map": {
              "messageId": "$.event.data.payload.messageId",
              "threadId": "$.event.data.payload.threadId",
              "response": "$.event.data.payload.response"
            }
          }
        ]
      ]
    },
    {
      "event": "user.message",
      "label": "Ignore Message",
      "exits": [
        [
          {
            "type": "action",
            "action": "Ignore Onboarding Message",
            "label": "send unable message",
            "map": {
              "threadId": "$.event.data.payload.threadId"
            }
          }
        ]
      ]
    }
  ],
  "Root Flow": {
    "root": true,
    "tracks": [
      {
        "event": "flow.entry",
        "label": "Flow Entry",
        "exits": [
          [
            {
              "type": "keep_alive"
            }
          ]
        ]
      },
      {
        "event": "tour.complete",
        "label": "Start Onboarding",
        "exits": [
          [
            {
              "type": "flow",
              "flow": "Onboarding Flow",
              "label": "run onboarding"
            }
          ]
        ]
      }
    ]
  },
  "Vision Flow": {
    "tracks": [
      {
        "event": "flow.entry",
        "label": "Flow Entry",
        "exits": [
          [
            {
              "type": "action",
              "action": "Describe Doc Images",
              "label": "describe images"
            },
            {
              "type": "fire",
              "event": "vision.complete",
              "label": "done"
            }
          ]
        ]
      }
    ]
  }
}
