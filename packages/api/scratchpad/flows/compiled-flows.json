{
  "Analysis Flow": [
    {
      "event": "flow.entry",
      "label": "Flow Entry",
      "steps": [
        {
          "type": "action",
          "action": "Analyze Text",
          "label": "analyze"
        },
        {
          "type": "fire",
          "event": "analysis.complete",
          "label": "notify"
        }
      ]
    }
  ],
  "Support Flow": [
    {
      "event": "flow.entry",
      "label": "Flow Entry",
      "steps": [
        {
          "type": "action",
          "action": "Analyze Text",
          "label": "classify"
        },
        {
          "type": "switch",
          "conditions": [
            {
              "if": "$.intent == 'question'",
              "steps": [
                {
                  "type": "action",
                  "action": "db query",
                  "label": "lookup"
                }
              ]
            },
            {
              "if": "$.intent == 'request'",
              "steps": [
                {
                  "type": "action",
                  "action": "Create Birth Thread",
                  "label": "onboard"
                }
              ]
            }
          ],
          "else": [
            {
              "type": "fire",
              "event": "support.escalated",
              "label": "escalate"
            }
          ]
        }
      ]
    }
  ],
  "Monitor Flow": [
    {
      "event": "flow.entry",
      "label": "Flow Entry",
      "steps": [
        {
          "type": "action",
          "action": "Analyze Text",
          "label": "init"
        },
        {
          "type": "keep_alive"
        }
      ]
    },
    {
      "event": "user.message",
      "label": "Handle Message",
      "steps": [
        {
          "type": "action",
          "action": "db query",
          "label": "process"
        },
        {
          "type": "fire",
          "event": "message.processed"
        }
      ]
    },
    {
      "event": "user.disconnect",
      "label": "Handle Disconnect",
      "steps": [
        {
          "type": "fire",
          "event": "session.ended",
          "label": "end"
        }
      ]
    }
  ],
  "Root Flow": {
    "root": true,
    "tracks": [
      {
        "event": "flow.entry",
        "label": "Flow Entry",
        "steps": [
          {
            "type": "action",
            "action": "Analyze Text",
            "label": "analyze input"
          },
          {
            "type": "switch",
            "conditions": [
              {
                "if": "$.intent == 'question'",
                "steps": [
                  {
                    "type": "action",
                    "action": "db query",
                    "label": "lookup"
                  }
                ]
              },
              {
                "if": "$.intent == 'request'",
                "steps": [
                  {
                    "type": "action",
                    "action": "Create Birth Thread",
                    "label": "onboard"
                  }
                ]
              }
            ],
            "else": [
              {
                "type": "action",
                "action": "Mock Block Messages",
                "label": "default response"
              }
            ]
          }
        ]
      }
    ]
  }
}
