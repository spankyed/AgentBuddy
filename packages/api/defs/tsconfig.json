{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "declarationMap": false,
    "composite": false,
    "baseUrl": "..",
    "paths": {
      "@abuddy/sdk": ["../abuddy-sdk/src/index.ts"],
      "@abuddy/sdk/inference": ["../abuddy-sdk/src/services/inference.ts"],
      "@abuddy/sdk/*": ["../abuddy-sdk/src/*/index.ts", "../abuddy-sdk/src/*"],
      "@/__generated__/*": ["../default-setup/src/__generated__/*"],
      "@/registries/*": ["../default-setup/src/registries/*"],
      "@/features/*": ["../default-setup/src/features/*"],
      "@/extensions/*": ["../default-setup/src/extensions/*"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "database.ts",
    "action.ts",
    "prompt.ts",
    "default-setup.ts",
    "plugin-types.ts",
    "../src/**/*"
  ]
}
