{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "declarationMap": false,
    "composite": false,
    "baseUrl": "..",
    "paths": {
      "@abuddy/sdk": ["../abuddy-sdk/src/index.ts"],
      "@abuddy/sdk/*": ["../abuddy-sdk/src/*/index.ts", "../abuddy-sdk/src/*"],
      "@/registries/*": ["../default-setup/src/registries/*"],
      "@/features/*": ["../default-setup/src/features/*"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "database.ts",
    "action.ts",
    "prompt.ts",
    "default-setup.ts",
    "plugin-types.ts",
    "../src/**/*"
  ]
}
