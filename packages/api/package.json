{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json && tsup src/types.ts src/server.ts --format esm,cjs --dts --shims --minify",
    "dev": "run-p dev:types dev:serve",
    "dev:types": "tsc -p . --watch --preserveWatchOutput",
    "dev:serve": "nodemon dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "generate:defs-types": "../../build/codegen/generate-defs.sh",
    "postbuild": "[ -z \"$SKIP_DEFS_GEN\" ] && npm run generate:defs-types || echo '⏭️  Skipping defs generation'",
    "db:cli": "tsx scripts/db/cli/run-db-cli.ts",
    "db:exec": "tsx scripts/db/cli/run-db-cli.ts --exec",
    "db:script": "tsx scripts/db/cli/run-db-cli.ts --script",
    "db:clearSettings": "tsx ./scripts/db/destroy-settings.ts",
    "db:export": "./scripts/db/export.sh",
    "db:import": "tsx scripts/db/import-backup.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:seed": "tsx scripts/db/seed/index.ts",
    "dsl:export": "tsx src/systems/flows/dsl/export-to-dsl.ts"
  },
  "keywords": [],
  "author": "angel santiago",
  "main": "dist/server.js",
  "types": "dist/types.d.ts",
  "files": [
    "dist/**/*",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./dist/server.js"
    },
    "./dist/*": "./dist/*"
  },
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^2.0.14",
    "@ai-sdk/openai": "^1.3.23",
    "@openai/codex-sdk": "^0.130.0",
    "@vscode/ripgrep": "^1.17.1",
    "ai": "^4.3.17",
    "chokidar": "^3.6.0",
    "croner": "^10.0.1",
    "dotenv": "^16.5.0",
    "esbuild": "^0.25.0",
    "fastify": "^5.3.2",
    "fs-extra": "^11.3.1",
    "graceful-fs": "^4.2.11",
    "lmdb": "^3.4.2",
    "node-pty": "^1.0.0",
    "playwright": "^1.54.1",
    "tar": "^7.4.3",
    "ws": "^8.18.2",
    "xstate": "^5.19.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@trpc/client": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.17",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.10",
    "rollup-plugin-dts": "^6.2.3",
    "tsc-alias": "^1.8.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.2"
  }
}
