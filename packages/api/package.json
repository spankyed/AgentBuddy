{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json && tsup src/types.ts src/server.ts --format esm,cjs --dts",
    "dev": "run-p dev:types dev:serve",
    "dev:types": "tsc -p . --watch --preserveWatchOutput",
    "dev:serve": "nodemon dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "generate:dsl-types": "../../scripts/generate-dsl-types-rollup.sh",
    "postbuild": "[ -z \"$SKIP_DSL_GEN\" ] && npm run generate:dsl-types || echo '⏭️  Skipping DSL generation'",
    "db:cli": "tsx src/cli/run-db-cli.ts",
    "db:exec": "tsx src/cli/run-db-cli.ts --exec",
    "db:script": "tsx src/cli/run-db-cli.ts --script",
    "db:export": "./scripts/db/export.sh"
  },
  "keywords": [],
  "author": "angel santiago",
  "main": "dist/server.js",
  "types": "dist/types.d.ts",
  "files": [
    "dist/**/*",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./dist/server.js"
    },
    "./dist/*": "./dist/*"
  },
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.23",
    "ai": "^4.3.17",
    "chokidar": "^3.6.0",
    "dotenv": "^16.5.0",
    "fastembed": "^1.14.1",
    "fastify": "^5.3.2",
    "lmdb": "^3.4.2",
    "node-pty": "^1.0.0",
    "openai": "^4.100.0",
    "playwright": "^1.54.1",
    "usearch": "^2.15.2",
    "uuid": "^11.1.0",
    "vitest": "^3.2.2",
    "ws": "^8.18.2",
    "xstate": "^5.19.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@trpc/client": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "@types/node": "^22.15.17",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.10",
    "rollup-plugin-dts": "^6.2.3",
    "tsc-alias": "^1.8.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
