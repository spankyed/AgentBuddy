{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,          // ← emit types
    "declarationMap": true,
    "emitDeclarationOnly": true,   // build‑time type pack
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["tests/*"]
    }
  },
  "include": ["src", "tests"]
}