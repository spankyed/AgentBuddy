{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,          // ← emit types
    "declarationMap": true,
    "emitDeclarationOnly": true,   // build‑time type pack
    "baseUrl": ".",
    "paths": {
      "@abuddy/sdk": ["../abuddy-sdk/src/index.ts"],
      "@abuddy/sdk/*": ["../abuddy-sdk/src/*/index.ts"],
      "@/registries/*": ["../default-setup/src/registries/*"],
      "@/features/*": ["../default-setup/src/features/*"],
      "@/shared-services/*": ["../default-setup/src/shared/services/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "tests"]
}