{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,          // ← emit types
    "declarationMap": true,
    "emitDeclarationOnly": true,   // build‑time type pack
    "baseUrl": ".",
    "paths": {
      "@abuddy/sdk": ["../abuddy-sdk/src/index.ts"],
      "@abuddy/sdk/*": ["../abuddy-sdk/src/*/index.ts"],
      "@abuddy/host/*": ["../abuddy-host/src/*/index.ts", "../abuddy-host/src/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "tests"]
}