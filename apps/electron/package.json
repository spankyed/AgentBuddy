{
  "name": "@abuddy/electron",
  "version": "1.0.0",
  "description": "AgentBuddy Desktop Application",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild",
    "dev": "run-p dev:build dev:start",
    "dev:build": "tsc --watch",
    "dev:start": "nodemon --watch dist --exec electron-forge start"
  },
  "keywords": [],
  "author": "angel santiago",
  "license": "ISC",
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-rpm": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.0",
    "@electron-forge/plugin-fuses": "^7.6.0",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.15.17",
    "electron": "^35.1.0",
    "electron-rebuild": "^3.2.9",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@abuddy/api": "workspace:*",
    "@abuddy/web": "workspace:*",
    "@trpc/client": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "electron-squirrel-startup": "^1.0.1"
  }
}