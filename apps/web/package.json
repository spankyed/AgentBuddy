{
  "name": "@abuddy/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "run-p dev:typecheck dev:serve",
    "dev:typecheck": "vue-tsc --noEmit --watch --preserveWatchOutput",
    "dev:serve": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "run-s typecheck build:prod",
    "build:prod": "vite build",
    "build:electron": "vite build --config vite.config.electron.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@abuddy/api": "workspace:*",
    "@antv/g6": "^5.0.48",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.37.2",
    "@guolao/vue-monaco-editor": "^1.5.5",
    "@leeoniya/ufuzzy": "^1.0.18",
    "@statelyai/inspect": "^0.4.0",
    "@trpc/client": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "@types/dagre": "^0.7.52",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.2",
    "@vue-flow/core": "^1.44.0",
    "@vue-flow/minimap": "^1.5.3",
    "@xstate/vue": "^4.0.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "dagre": "^0.8.5",
    "gitdiff-parser": "^0.3.1",
    "lucide-vue-next": "^0.503.0",
    "monaco-editor": "^0.52.2",
    "reka-ui": "^2.2.1",
    "vue": "^3.3.4",
    "vue-arrange": "^1.5.0",
    "xstate": "^5.19.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitest/ui": "^3.2.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.14",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.24",
    "sass": "^1.87.0",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.8.3",
    "vite": "^4.4.5",
    "vitest": "^3.2.2",
    "vue-tsc": "^2.0.0"
  }
