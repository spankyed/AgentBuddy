{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Let Vitest & editors see its own globals
    "types": ["vitest/globals", "node"],
    // Allow sources anywhere – we are *not* emitting
    "rootDir": ".",
    // Turn off declaration emit for speed during testing
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["tests/*"],
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ]
}