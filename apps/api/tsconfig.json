{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,          // ← emit types
    "declarationMap": true,
    "emitDeclarationOnly": false,   // emit JS files too
    "noEmit": false,               // override base config
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
    },
    "moduleResolution": "node",
    "module": "commonjs",
    "allowImportingTsExtensions": false
  },
  "include": ["src"]
}