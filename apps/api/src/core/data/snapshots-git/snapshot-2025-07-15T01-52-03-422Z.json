                "severity": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warning",
                    "info"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "Prompt-3": {
      "timestamp": 1752285116568,
      "label": "Q&A Assistant",
      "description": "Answers questions based on context",
      "category": "assistant",
      "inputs": {
        "question": {
          "name": "question",
          "type": "string",
          "description": "The user's question",
          "required": true
        },
        "context": {
          "name": "context",
          "type": "string",
          "description": "Additional context or knowledge base",
          "required": false,
          "defaultValue": ""
        },
        "tone": {
          "name": "tone",
          "type": "string",
          "description": "Response tone",
          "required": false,
          "defaultValue": "professional"
        }
      },
      "templateFn": "const { question, context = '', tone = 'professional' } = params;\n\nif (context) {\n  // prettier-ignore\n  return `\n    Context:\n    ${context}\n\n    Please answer the following question in a ${tone} tone:\n\n    ${question}\n\n    Provide a clear and helpful response.\n  `;\n}\n\n// prettier-ignore\nreturn `\n  Please answer the following question in a ${tone} tone:\n\n  ${question}\n\n  Provide a clear and helpful response.\n`;",
      "updatedAt": 1752285116568
    },
    "Prompt-4": {
      "timestamp": 1752198716568,
      "label": "Translate Text",
      "description": "Translates text between languages",
      "category": "text-processing",
      "inputs": {
        "text": {
          "name": "text",
          "type": "string",
          "description": "The text to translate",
          "required": true
        },
        "sourceLang": {
          "name": "sourceLang",
          "type": "string",
          "description": "Source language (e.g., \"en\", \"es\", \"fr\")",
          "required": false,
          "defaultValue": "auto"
        },
        "targetLang": {
          "name": "targetLang",
          "type": "string",
          "description": "Target language (e.g., \"en\", \"es\", \"fr\")",
          "required": true,
          "example": "en"
        },
        "style": {
          "name": "style",
          "type": "string",
          "description": "Translation style",
          "required": false,
          "defaultValue": "natural"
        }
      },
      "templateFn": "const { text, sourceLang = 'auto', targetLang, style = 'natural' } = params;\n\n// prettier-ignore\nreturn `\n  Please translate the following text to ${targetLang}:\n\n  ${text}\n\n  Translation requirements:\n  - ${sourceLang === 'auto' ? 'Detect the source language automatically' : 'Source language: ' + sourceLang}\n  - Target language: ${targetLang}\n  - Translation style: ${style} (preserve the original tone and meaning)\n  - Maintain formatting and structure\n  - Ensure cultural appropriateness\n\n  Provide only the translated text without explanations.\n`;",
      "updatedAt": 1752457916568
    },
    "Prompt-5": {
      "timestamp": 1752025916568,
      "label": "Sentiment Analysis",
