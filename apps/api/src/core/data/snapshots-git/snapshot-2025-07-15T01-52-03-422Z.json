    "Prompt-1": {
      "timestamp": 1751939516568,
      "label": "Summarize Text",
      "description": "Summarizes long text into key points",
      "category": "text-processing",
      "inputs": {
        "text": {
          "name": "text",
          "type": "string",
          "description": "The text to summarize",
          "required": true,
          "example": "Long article or document text..."
        },
        "maxLength": {
          "name": "maxLength",
          "type": "number",
          "description": "Maximum length of summary in words",
          "required": false,
          "defaultValue": 100
        }
      },
      "templateFn": "const { text, maxLength = 100 } = params;\n// prettier-ignore\nreturn `\n  Please summarize the following text in approximately ${maxLength} words:\n\n  ${text}\n\n  Provide a clear, concise summary focusing on the main points.\n`;",
      "updatedAt": 1752371516568
    },
    "Prompt-2": {
      "timestamp": 1752112316568,
      "label": "Code Review",
      "description": "Reviews code for quality and suggestions",
      "category": "development",
      "inputs": {
