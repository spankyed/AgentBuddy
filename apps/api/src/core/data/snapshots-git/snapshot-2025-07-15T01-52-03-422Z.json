            }
          }
        }
      }
    },
    "Prompt-6": {
      "timestamp": 1751853116569,
      "label": "Brainstorm Ideas",
      "description": "Generates creative ideas for a given topic",
      "category": "creative",
      "inputs": {
        "topic": {
          "name": "topic",
          "type": "string",
          "description": "The topic to brainstorm about",
          "required": true
        },
        "quantity": {
          "name": "quantity",
          "type": "number",
          "description": "Number of ideas to generate",
          "required": false,
          "defaultValue": 5
        },
        "constraints": {
          "name": "constraints",
          "type": "string",
          "description": "Any constraints or requirements",
          "required": false,
          "defaultValue": ""
        },
        "creativity": {
          "name": "creativity",
          "type": "string",
          "description": "Creativity level",
          "required": false,
          "defaultValue": "balanced",
          "example": "conservative, balanced, creative, wild"
        }
      },
      "templateFn": "const { topic, quantity = 5, constraints = '', creativity = 'balanced' } = params;\n\n// prettier-ignore\nreturn `\n\nPlease brainstorm ${quantity} ${creativity} ideas for:\n\n${topic}\n\n${constraints ? 'Constraints/Requirements:\\n' + constraints + '\\n\\n' : ''}Guidelines:\n- Generate ${quantity} distinct ideas\n- Creativity level: ${creativity}\n- Each idea should be practical and actionable\n- Include a brief explanation for each idea\n- Consider different perspectives and approaches\n- Be specific rather than generic\n\nPresent each idea with:\n1. A clear title\n2. A 2-3 sentence description\n3. Key benefits or potential impact\n\n`;",
      "updatedAt": 1752285116569
    },
    "Prompt-user-message-analysis": {
      "timestamp": 1752371516569,
      "label": "User Message Analysis",
      "description": "Analyzes user messages to extract intent, entities, and sentiment",
      "category": "analysis",
      "inputs": {
        "userMessage": {
          "name": "userMessage",
          "type": "string",
          "description": "The user's message to analyze",
          "required": true
        },
        "additionalContext": {
          "name": "additionalContext",
          "type": "string",
          "description": "Additional context about the conversation",
          "required": false,
          "defaultValue": ""
        }
      },
      "templateFn": "const { userMessage, additionalContext = '' } = params;\n\n// prettier-ignore\nreturn `\n  Analyze the following user message and extract key information:\n\n  User Message: \"${userMessage}\"\n\n  ${additionalContext ? `Additional Context: ${additionalContext}\n\n` : ''}\n\n  Please provide a detailed analysis including:\n  1. Summary: A brief summary of what the user is asking or saying\n  2. Intent: The primary intent or goal of the message (e.g., question, request, feedback, etc.)\n  3. Entities: Key entities, topics, or concepts mentioned\n  4. Category: Categorize the message (e.g., technical_support, general_inquiry, feature_request, etc.)\n  5. Urgency: Assess the urgency level (low, medium, high)\n\n  Format your response as a structured analysis.\n`;",
      "updatedAt": 1752371516569
    },
    "Prompt-format-response": {
      "timestamp": 1752371516569,
      "label": "Format Response",
      "description": "Formats AI responses based on analysis results and style preferences",
      "category": "formatting",
      "inputs": {
        "userMessage": {
          "name": "userMessage",
          "type": "string",
          "description": "The original user message",
          "required": true
        },
        "analysisResult": {
          "name": "analysisResult",
          "type": "object",
          "description": "The analysis result from the previous step",
          "required": true
        },
        "responseStyle": {
          "name": "responseStyle",
          "type": "string",
          "description": "The desired response style",
          "required": false,
          "defaultValue": "helpful and professional"
        }
      },
      "templateFn": "const { userMessage, analysisResult, responseStyle = 'helpful and professional' } = params;\n\n// prettier-ignore\nreturn `\n  Based on the following analysis of the user's message, craft an appropriate response.\n\n  Original User Message: \"${userMessage}\"\n\n  Analysis Result:\n  ${JSON.stringify(analysisResult, null, 2)}\n\n  Please format a response that is ${responseStyle}.\n\n  The response should:\n  1. Address the user's primary intent as identified in the analysis\n  2. Be clear, concise, and helpful\n  3. Include any relevant suggestions or next steps\n  4. Maintain a ${responseStyle} tone throughout\n\n  Format your response as a natural, conversational message.\n`;",
      "updatedAt": 1752371516569
    },
    "Action-stream-to-fe": {
      "timestamp": 1752544316499,
      "label": "Stream to FE",
      "description": "Streams a message to the front-end",
      "category": "utility",
      "updatedAt": 1752544316499,
      "input": {
        "message": {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "User message"
        }
      },
      "actionFn": "const { message } = params;\n\nconst result = await services.llm.streamText({\n  model: { provider: 'openai', model: 'gpt-4o' },\n  prompt: message,\n  system: 'You are a helpful assistant.',\n  temperature: 0.7,\n  maxTokens: 100,\n});\n\nfor await (const textPart of result.textStream) {\n  services.logger.info('Streaming text to FE', { textPart });\n\n  services.emitter.sendToPlugin('agent', {\n    type: 'TOKEN_STREAM',\n    token: textPart\n  });\n}\n\nawait result.finishReason\n\nservices.emitter.sendToPlugin('agent', {\n  type: 'LLM_DONE',\n});",
      "output": {
        "logged": "boolean",
        "message": "string"
      }
    },
    "Action-save-entity": {
      "timestamp": 1752544316469,
      "label": "Save Entity",
      "description": "Saves an entity to the database",
      "category": "database",
      "updatedAt": 1752544316469,
      "input": {
        "entityType": {
          "name": "entityType",
          "type": "string",
          "required": true,
          "description": "The type of entity to save",
          "placeholder": "e.g., User, Post, Comment"
        },
        "data": {
          "name": "data",
          "type": "object",
          "required": true,
          "description": "The entity data to save"
        }
      },
      "actionFn": "const { entityType, data } = params;\n\nconst result = await services.database.insert(entityType, data);\nawait services.logger.info('Entity saved', { entityType, id: result.id });\n\nreturn result;",
      "output": {
        "id": "string",
        "success": "boolean"
      }
    },
    "Action-log-message": {
      "timestamp": 1752544316623,
      "label": "Log Message",
      "description": "Logs a message with optional data",
      "category": "utility",
      "updatedAt": 1752544316623,
      "input": {
        "level": {
          "name": "level",
          "type": "string",
          "required": true,
          "description": "Log level",
          "placeholder": "info, error, debug",
          "default": "info"
        },
        "message": {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "Log message"
        },
        "data": {
          "name": "data",
          "type": "object",
          "required": false,
          "description": "Additional data to log"
        }
      },
      "actionFn": "const { level, message, data } = params;\n\nswitch (level) {\n  case 'error':\n    return await services.logger.error(message, data);\n  case 'debug':\n    return await services.logger.debug(message, data);\n  case 'info':\n  default:\n    return await services.logger.info(message, data);\n}",
      "output": {
        "logged": "boolean",
        "message": "string"
      }
    },
