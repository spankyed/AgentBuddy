      "templateFn": "const { code, language, focusAreas = ['bugs', 'performance', 'readability'] } = params;\n// prettier-ignore\nreturn `\n  Please review the following ${language} code:\n\n  \\`\\`\\`${language}\n  ${code}\n  \\`\\`\\`\n\n  Focus on: ${focusAreas.join(', ')}\n\n  Provide specific suggestions for improvements.\n`;",
