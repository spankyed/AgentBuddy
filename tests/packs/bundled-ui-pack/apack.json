{
  "$schema": "../../../packages/apack-sdk/apack.schema.json",
  "id": "bundled-ui-fixture",
  "name": "Bundled UI Fixture",
  "version": "0.1.0",
  "hostVersion": ">=0.3.0",
  "entities": {},
  "relKinds": {},
  "features": {
    "scribbles": {
      "settings": {
        "schema": {
          "type": "object",
          "additionalProperties": false
        },
        "defaults": {}
      },
      "plugin": {
        "entry": "src/features/scribbles/fe/plugin.ts",
        "defaultVisible": true
      },
      "services": {}
    }
  },
  "extensions": {
    "settings": {
      "restricted": {
        "title": "Owner-only preference",
        "access": "owner",
        "schema": {
          "type": "object",
          "properties": { "count": { "type": "integer", "minimum": 1, "maximum": 10 } },
          "required": ["count"],
          "additionalProperties": false
        },
        "defaults": { "count": 1 }
      },
      "assistant": {
        "title": "Scribbles Assistant",
        "schema": {
          "type": "object",
          "properties": { "name": { "type": "string" } },
          "required": ["name"],
          "additionalProperties": false
        },
        "defaults": { "name": "Scribbles helper" },
        "form": "src/extensions/settings/assistant.vue"
      }
    }
  },
  "dependencies": {},
  "permissions": [],
  "build": {
    "bundleUi": true
  }
}
