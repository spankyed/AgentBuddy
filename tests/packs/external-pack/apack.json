{
  "$schema": "../../../packages/apack-sdk/apack.schema.json",
  "id": "e2e-fixture",
  "name": "E2E Fixture",
  "version": "0.1.0",
  "hostVersion": ">=0.3.0",
  "features": {
    "memos": {
      "settings": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "listTitle": {
              "type": "string",
              "description": "Heading shown above the memo list."
            }
          },
          "required": [
            "listTitle"
          ]
        },
        "defaults": {
          "listTitle": "Memos"
        },
        "title": "Memos",
        "form": "src/features/memos/fe/settings.vue"
      },
      "system": {
        "entry": "src/features/memos/be/system.ts",
        "contract": "src/features/memos/be/contract.ts#Contract"
      },
      "plugin": {
        "contract": "src/features/memos/fe/contract.ts#Contract",
        "defaultVisible": false,
        "label": "Memos",
        "icon": "StickyNote",
        "state": "src/features/memos/fe/state.ts",
        "canvas": {
          "entry": "src/features/memos/fe/canvas/list.vue",
          "load": "lazy"
        }
      },
      "services": {},
      "repositories": {
        "memoQueries": "src/features/memos/be/repository.ts#memoQueries",
        "memoCommands": "src/features/memos/be/repository.ts#memoCommands"
      },
      "references": {
        "types": {
          "memo": {
            "category": "memos",
            "icon": "StickyNote",
            "svgElements": [
              [
                "rect",
                {
                  "x": "3",
                  "y": "3",
                  "width": "18",
                  "height": "18",
                  "rx": "2"
                }
              ]
            ],
            "navigate": "src/features/memos/fe/references.ts#openMemo"
          }
        },
        "categories": {
          "memos": {
            "label": "Memos",
            "icon": "StickyNote",
            "useItems": "src/features/memos/fe/references.ts#useItems"
          }
        }
      },
      "entities": {
        "Memo": "src/features/memos/be/types.ts#MemoEntity"
      },
      "types": "src/features/memos/be/types.ts"
    },
    "notes": {
      "settings": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "listTitle": {
              "type": "string"
            }
          },
          "required": [
            "listTitle"
          ]
        },
        "defaults": {
          "listTitle": "Fixture Notes"
        },
        "title": "Fixture Notes"
      },
      "plugin": {
        "label": "Fixture Notes",
        "icon": "NotebookPen",
        "state": "src/features/notes/fe/state.ts",
        "canvas": "src/features/notes/fe/canvas/list.vue"
      },
      "services": {}
    }
  },
  "extensions": {
    "settings": {
      "assistant": {
        "title": "Fixture Assistant",
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "defaults": {
          "name": "Memo helper"
        },
        "form": "src/extensions/settings/assistant.vue"
      }
    },
    "help": {
      "path": "src/extensions/help"
    },
    "steps": {
      "stamp": {
        "node": "src/extensions/steps/stamp/build.ts#stampStepNode",
        "build": "src/extensions/steps/stamp/build.ts#stampStepBuild",
        "fe": "src/extensions/steps/stamp/fe.ts#stampStepFE",
        "runtime": {
          "handler": "src/extensions/steps/stamp/runtime.ts#handler"
        },
        "dsl": {
          "primaryField": "note"
        }
      },
      "pulse": {
        "kind": "trigger",
        "node": "src/extensions/steps/pulse/trigger.ts#pulseTriggerNode",
        "trigger": {
          "facet": "src/extensions/steps/pulse/trigger.ts#pulseTriggerBuild"
        },
        "fe": "src/extensions/steps/pulse/fe.ts#pulseTriggerFE"
      }
    },
    "artifacts": {
      "stamp": {
        "icon": "Stamp",
        "fe": "src/extensions/artifacts/viewers/stamp-artifact.vue"
      }
    },
    "blocks": {
      "stamp": {
        "fe": "src/extensions/blocks/display/StampBlock.vue"
      }
    },
    "commands": {
      "memo-note": {
        "placeholder": "Memo text"
      }
    }
  },
  "dependencies": {
    "default-setup": "*"
  },
  "permissions": [],
  "content": {
    "sources": {
      "actions": "src/content/actions",
      "flows": "src/content/flows",
      "memos": {
        "path": "src/content/memos",
        "format": "memos"
      },
      "quick-memos": {
        "path": "src/content/quick-memos.txt",
        "format": "quick-memos"
      },
      "library": {
        "path": "src/content/library",
        "format": "default-setup:library"
      }
    },
    "formats": {
      "memos": {
        "format": "markdown-tree",
        "entity": "Memo",
        "identity": [
          "title"
        ],
        "fields": {
          "title": {
            "from": "frontmatter.title",
            "default": "filename",
            "type": "string"
          },
          "text": {
            "from": "body"
          }
        }
      },
      "quick-memos": {
        "compiler": "src/content/compilers/quick-memos.ts",
        "entity": "Memo",
        "identity": [
          "title"
        ]
      }
    }
  },
  "data": {
    "relations": []
  },
  "lifecycle": {
    "onInit": "src/features/hooks.ts#onInit",
    "onShutdown": "src/features/hooks.ts#onShutdown"
  }
}
